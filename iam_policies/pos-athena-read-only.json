{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::example-pos-datalake/raw/*",
        "arn:aws:s3:::example-pos-datalake/processed/*",
        "arn:aws:s3:::example-pos-datalake/rollup_item/*",
        "arn:aws:s3:::example-pos-datalake/rollup_dept/*",
        "arn:aws:s3:::example-pos-datalake/reference/*",
        "arn:aws:s3:::example-pos-datalake/athena-results/*"
      ]
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::example-pos-datalake"
    },
    {
      "Sid": "AthenaResultsWriteOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::example-pos-datalake/athena-results/*"
    },
    {
      "Sid": "NoWritingToTheData",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::example-pos-datalake/raw/*",
        "arn:aws:s3:::example-pos-datalake/processed/*",
        "arn:aws:s3:::example-pos-datalake/rollup_item/*",
        "arn:aws:s3:::example-pos-datalake/rollup_dept/*",
        "arn:aws:s3:::example-pos-datalake/reference/*"
      ]
    },
    {
      "Sid": "RunQueriesInThisWorkgroupOnly",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetQueryResultsStream",
        "athena:GetWorkGroup",
        "athena:ListQueryExecutions"
      ],
      "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/pos-analytics"
    },
    {
      "Sid": "ReadCatalogue",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:us-east-1:123456789012:catalog",
        "arn:aws:glue:us-east-1:123456789012:database/pos_analytics",
        "arn:aws:glue:us-east-1:123456789012:table/pos_analytics/*"
      ]
    }
  ]
}
